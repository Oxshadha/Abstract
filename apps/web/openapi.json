  "info": {
    "title": "Abstract. API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/_debug/ping": {
      "get": {
        "operationId": "ping_worker_api_v1__debug_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pong"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Round-trip a task through the worker",
        "tags": [
          "debug"
        ]
      }
    },
    "/api/v1/admin/llm/kill-switch": {
      "get": {
        "operationId": "get_kill_switch_api_v1_admin_llm_kill_switch_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KillSwitch"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Whether paid model calls are enabled",
        "tags": [
          "admin"
        ]
      },
      "put": {
        "operationId": "set_kill_switch_api_v1_admin_llm_kill_switch_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KillSwitch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KillSwitch"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Enable or pause every paid model call",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/llm/usage/summary": {
      "get": {
        "operationId": "usage_summary_api_v1_admin_llm_usage_summary_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageSummary"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Today's model usage and cost (aggregates only)",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/models": {
      "get": {
        "operationId": "list_models_api_v1_admin_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistryList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Model Registry entries",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/models/{task}": {
      "put": {
        "operationId": "update_model_api_v1_admin_models__task__put",
        "parameters": [
          {
            "in": "path",
            "name": "task",
            "required": true,
            "schema": {
              "pattern": "^[a-z_]{2,32}$",
              "title": "Task",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "maxLength": 40,
              "title": "If-Match",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistryUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistryEntryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "Re-index confirmation needed"
          },
