{
  "components": {
    "schemas": {
      "DevToken": {
        "properties": {
          "token": {
            "title": "Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "DevToken",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Me": {
        "properties": {
          "org": {
            "$ref": "#/components/schemas/MeOrg"
          },
          "role": {
            "enum": [
              "owner",
              "member"
            ],
            "title": "Role",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/MeUser"
          }
        },
        "required": [
          "user",
          "org",
          "role"
        ],
        "title": "Me",
        "type": "object"
      },
      "MeOrg": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "personal",
              "team"
            ],
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ],
        "title": "MeOrg",
        "type": "object"
      },
      "MeUser": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "platform_role": {
            "enum": [
              "user",
              "admin"
            ],
            "title": "Platform Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "platform_role"
        ],
        "title": "MeUser",
        "type": "object"
      },
      "Pong": {
        "properties": {
          "pong": {
            "title": "Pong",
            "type": "boolean"
          },
          "worker": {
            "title": "Worker",
            "type": "string"
          }
        },
        "required": [
          "pong",
          "worker"
        ],
        "title": "Pong",
        "type": "object"
      },
      "Ready": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Ready",
        "type": "object"
      },
      "Received": {
        "properties": {
          "received": {
            "title": "Received",
            "type": "boolean"
          }
        },
        "required": [
          "received"
        ],
        "title": "Received",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Abstract. API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/_debug/ping": {
      "get": {
        "operationId": "ping_worker_api_v1__debug_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pong"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Round-trip a task through the worker",
        "tags": [
          "debug"
        ]
      }
    },
    "/api/v1/dev/token": {
      "post": {
        "operationId": "dev_token_api_v1_dev_token_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevToken"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Issue a token for the demo user",
        "tags": [
          "dev"
        ]
      }
    },
    "/api/v1/healthz": {
      "get": {
        "operationId": "healthz_api_v1_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness (no dependencies)",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The signed-in user and their active organization",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/readyz": {
      "get": {
        "operationId": "readyz_api_v1_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "A dependency is unavailable (problem+json)"
          }
        },
        "summary": "Readiness: database, redis and object storage reachable",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/webhooks/clerk": {
      "post": {
        "operationId": "clerk_webhook_api_v1_webhooks_clerk_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Received"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Clerk user lifecycle events (Svix-signed)",
        "tags": [
          "webhooks"
        ]
      }
    }
  }
}
