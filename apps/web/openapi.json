{
  "components": {
    "schemas": {
      "DevToken": {
        "properties": {
          "token": {
            "title": "Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "DevToken",
        "type": "object"
      },
      "FinalizeRequest": {
        "additionalProperties": false,
        "properties": {
          "upload_id": {
            "format": "uuid",
            "title": "Upload Id",
            "type": "string"
          }
        },
        "required": [
          "upload_id"
        ],
        "title": "FinalizeRequest",
        "type": "object"
      },
      "FinalizeResponse": {
        "properties": {
          "duplicate": {
            "default": false,
            "title": "Duplicate",
            "type": "boolean"
          },
          "job": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "paper": {
            "$ref": "#/components/schemas/PaperOut"
          }
        },
        "required": [
          "paper"
        ],
        "title": "FinalizeResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "JobOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "step": {
            "title": "Step",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "step"
        ],
        "title": "JobOut",
        "type": "object"
      },
      "Me": {
        "properties": {
          "org": {
            "$ref": "#/components/schemas/MeOrg"
          },
          "role": {
            "enum": [
              "owner",
              "member"
            ],
            "title": "Role",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/MeUser"
          }
        },
        "required": [
          "user",
          "org",
          "role"
        ],
        "title": "Me",
        "type": "object"
      },
      "MeOrg": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "personal",
              "team"
            ],
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ],
        "title": "MeOrg",
        "type": "object"
      },
      "MeUser": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "platform_role": {
            "enum": [
              "user",
              "admin"
            ],
            "title": "Platform Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "platform_role"
        ],
        "title": "MeUser",
        "type": "object"
      },
      "PaperOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "pages": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pages"
          },
          "size_bytes": {
            "title": "Size Bytes",
            "type": "integer"
          },
          "status": {
            "enum": [
              "processing",
              "ready",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "text_status": {
            "enum": [
              "pending",
              "ready",
              "failed"
            ],
            "title": "Text Status",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "id",
          "filename",
          "title",
          "pages",
          "size_bytes",
          "status",
          "text_status",
          "error_message",
          "created_at"
        ],
        "title": "PaperOut",
        "type": "object"
      },
      "Pong": {
        "properties": {
          "pong": {
            "title": "Pong",
            "type": "boolean"
          },
          "worker": {
            "title": "Worker",
            "type": "string"
          }
        },
        "required": [
          "pong",
          "worker"
        ],
        "title": "Pong",
        "type": "object"
      },
      "Ready": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Ready",
        "type": "object"
      },
      "Received": {
        "properties": {
          "received": {
            "title": "Received",
            "type": "boolean"
          }
        },
        "required": [
          "received"
        ],
        "title": "Received",
        "type": "object"
      },
      "RoleChange": {
        "properties": {
          "platform_role": {
            "enum": [
              "user",
              "admin"
            ],
            "title": "Platform Role",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "platform_role"
        ],
        "title": "RoleChange",
        "type": "object"
      },
      "UploadRequest": {
        "additionalProperties": false,
        "properties": {
          "content_type": {
            "const": "application/pdf",
            "default": "application/pdf",
            "title": "Content Type",
            "type": "string"
          },
          "filename": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "sha256": {
            "maxLength": 10000,
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "size_bytes": {
            "exclusiveMinimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "filename",
          "size_bytes",
          "sha256"
        ],
        "title": "UploadRequest",
        "type": "object"
      },
      "UploadTicket": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Fields",
            "type": "object"
          },
          "upload_id": {
            "format": "uuid",
            "title": "Upload Id",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "upload_id",
          "url",
          "fields",
          "expires_at"
        ],
        "title": "UploadTicket",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Abstract. API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/_debug/ping": {
      "get": {
        "operationId": "ping_worker_api_v1__debug_ping_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pong"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Round-trip a task through the worker",
        "tags": [
          "debug"
        ]
      }
    },
    "/api/v1/admin/users/{user_id}/grant-admin": {
      "post": {
        "operationId": "grant_admin_api_v1_admin_users__user_id__grant_admin_post",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleChange"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Grant Admin",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/admin/users/{user_id}/revoke-admin": {
      "post": {
        "operationId": "revoke_admin_api_v1_admin_users__user_id__revoke_admin_post",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "User Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleChange"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Revoke Admin",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/dev/token": {
      "post": {
        "operationId": "dev_token_api_v1_dev_token_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevToken"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Issue a token for the demo user",
        "tags": [
          "dev"
        ]
      }
    },
    "/api/v1/healthz": {
      "get": {
        "operationId": "healthz_api_v1_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness (no dependencies)",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The signed-in user and their active organization",
        "tags": [
          "identity"
        ]
      }
    },
    "/api/v1/papers": {
      "post": {
        "operationId": "finalize_upload_api_v1_papers_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinalizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalizeResponse"
                }
              }
            },
            "description": "Already uploaded (duplicate)"
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalizeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Finish an upload: validate the stored file and start processing",
        "tags": [
          "papers"
        ]
      }
    },
    "/api/v1/papers/uploads": {
      "post": {
        "operationId": "create_upload_api_v1_papers_uploads_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadTicket"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start an upload: a short-lived pre-signed form to send one PDF directly to storage",
        "tags": [
          "papers"
        ]
      }
    },
    "/api/v1/readyz": {
      "get": {
        "operationId": "readyz_api_v1_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "A dependency is unavailable (problem+json)"
          }
        },
        "summary": "Readiness: database, redis and object storage reachable",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/webhooks/clerk": {
      "post": {
        "operationId": "clerk_webhook_api_v1_webhooks_clerk_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Received"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Clerk user lifecycle events (Svix-signed)",
        "tags": [
          "webhooks"
        ]
      }
    }
  }
}
