# Copy to .env at the repo root:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# --- App ---
ENV=development
LOG_LEVEL=INFO

# --- Local ports (change if something else uses them) ---
WEB_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=8333

# --- Postgres (local container; production uses Neon) ---
POSTGRES_USER=abstract
POSTGRES_PASSWORD=abstract
POSTGRES_DB=abstract
# Used when running the API/tests on the host (outside Docker).
# Runtime role (never the table owner, so row-level security always applies):
DATABASE_URL=postgresql+asyncpg://abstract_app:abstract_app_dev@localhost:5432/abstract
# Owner role, used only for migrations:
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://abstract:abstract@localhost:5432/abstract
REDIS_URL=redis://localhost:6379/0

# --- Object storage (local S3-compatible server; production uses AWS S3) ---
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=abstract-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=abstract-dev
S3_SECRET_ACCESS_KEY=abstract-dev-secret

# --- Authentication (spec 002, D70) ---
# Leave CLERK_ISSUER empty to use the built-in development login (demo user, dev only).
# Production requires Clerk: the app refuses to start without it when ENV=production.
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=["http://localhost:5173"]
# Frontend: set VITE_CLERK_PUBLISHABLE_KEY in apps/web/.env.local to use Clerk sign-in;
# without it the web app uses the development login automatically.
# Webhook signing secret from the Clerk dashboard (whsec_...). Empty = webhooks disabled.
CLERK_WEBHOOK_SECRET=

# --- LLM providers (D24) ---
# fake = deterministic, no network, no cost (default; used by tests/CI)
# openrouter = real models via OpenRouter (needs OPENROUTER_API_KEY)
# fake: every task uses the fake model (no paid calls). vertex or openrouter: the Model
# Registry routes each task; providers with credentials below are used (spec 005).
LLM_PROVIDER=fake
OPENROUTER_API_KEY=

# --- Google Vertex AI (optional second provider) ---
# Path to your service-account JSON on the host. It is mounted into containers as a
# read-only secret. Keep the file out of git (*service-account*.json is ignored).
GCP_SA_FILE=
GCP_PROJECT_ID=
GCP_LOCATION=global

# --- Error monitoring (Sentry, D37, D76) ---
# DSNs are public by design. Empty = monitoring off. Web uses VITE_SENTRY_DSN (Vite reads this
# root .env; only VITE_-prefixed values reach the browser).
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Source-map upload (CI/deploy only): org slug, web project slug and an auth token with
# project:releases scope. Keep the token out of .env in production (GitHub secret instead).
SENTRY_ORG=
SENTRY_PROJECT_WEB=
SENTRY_AUTH_TOKEN=

# Malware scanning (D77). Unset = fake scanner in development. Production must set clamav,
# guardduty, or the explicit opt-out disabled-with-sanitization (sanitized copy + sandbox only).
# MALWARE_SCAN=
# CLAMAV_HOST=clamav

# Tracing (spec 005 AC14): metadata only (no prompts or answers). Off until both keys are set.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   (EU; LANGFUSE_HOST is accepted too)
# APP_RELEASE=   (deployed version, e.g. the git SHA; shown on traces)
