{
  "$description": "Abstract. design tokens: the single source for colour, type, radius, spacing and shadow (spec 003 AC1, D33, D34). Colours are WCAG AA checked (docs/decisions.md D34). Generate with `make tokens`.",
  "base": {
    "font": {
      "display": { "$type": "fontFamily", "$value": "'Google Sans Flex Variable', 'Google Sans', system-ui, sans-serif" },
      "ui": { "$type": "fontFamily", "$value": "'Google Sans', 'Google Sans Flex Variable', system-ui, sans-serif" },
      "reading": { "$type": "fontFamily", "$value": "'Nunito Sans Variable', system-ui, sans-serif" }
    },
    "radius": {
      "sm": { "$type": "dimension", "$value": "6px" },
      "md": { "$type": "dimension", "$value": "10px" },
      "lg": { "$type": "dimension", "$value": "14px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "spacing": { "unit": { "$type": "dimension", "$value": "4px" } },
    "shadow": {
      "card": { "$type": "shadow", "$value": "0 1px 2px rgba(20, 20, 20, 0.04), 0 4px 16px rgba(20, 20, 20, 0.04)" },
      "overlay": { "$type": "shadow", "$value": "0 12px 40px rgba(20, 20, 20, 0.16)" }
    },
    "color": {
      "highlight": { "$type": "color", "$value": "rgba(255, 213, 79, 0.40)" }
    }
  },
  "light": {
    "color": {
      "bg": { "$type": "color", "$value": "#FAFAF8" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "text": { "$type": "color", "$value": "#202020" },
      "text-secondary": { "$type": "color", "$value": "#71716C" },
      "border": { "$type": "color", "$value": "#E8E8E5" },
      "border-strong": { "$type": "color", "$value": "#8A8A85" },
      "primary": { "$type": "color", "$value": "#202020" },
      "primary-text": { "$type": "color", "$value": "#FFFFFF" },
      "muted": { "$type": "color", "$value": "#F1F1EE" },
      "success": { "$type": "color", "$value": "#2A7046" },
      "success-bg": { "$type": "color", "$value": "#E8F3EB" },
      "warning": { "$type": "color", "$value": "#8F5A0C" },
      "warning-bg": { "$type": "color", "$value": "#FFF3DF" },
      "error": { "$type": "color", "$value": "#B3261E" },
      "error-bg": { "$type": "color", "$value": "#FCEAE8" },
      "info": { "$type": "color", "$value": "#3A5BA0" },
      "info-bg": { "$type": "color", "$value": "#EAF0FA" },
      "focus": { "$type": "color", "$value": "#202020" }
    }
  },
  "dark": {
    "color": {
      "bg": { "$type": "color", "$value": "#151515" },
      "surface": { "$type": "color", "$value": "#222222" },
      "text": { "$type": "color", "$value": "#F1F1ED" },
      "text-secondary": { "$type": "color", "$value": "#A6A6A0" },
      "border": { "$type": "color", "$value": "#333333" },
      "border-strong": { "$type": "color", "$value": "#73736E" },
      "primary": { "$type": "color", "$value": "#F1F1ED" },
      "primary-text": { "$type": "color", "$value": "#151515" },
      "muted": { "$type": "color", "$value": "#2B2B2A" },
      "success": { "$type": "color", "$value": "#7CC496" },
      "success-bg": { "$type": "color", "$value": "#203A2A" },
      "warning": { "$type": "color", "$value": "#E5AE5C" },
      "warning-bg": { "$type": "color", "$value": "#41311C" },
      "error": { "$type": "color", "$value": "#F28B82" },
      "error-bg": { "$type": "color", "$value": "#422321" },
      "info": { "$type": "color", "$value": "#93ADE6" },
      "info-bg": { "$type": "color", "$value": "#253247" },
      "focus": { "$type": "color", "$value": "#F1F1ED" }
    }
  }
}
